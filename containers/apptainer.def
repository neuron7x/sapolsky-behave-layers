Bootstrap: docker
From: nvidia/cuda:12.8.0-runtime-ubuntu22.04
%post
    apt-get update && apt-get install -y python3.10 python3-pip git curl ca-certificates
    curl -LsSf https://astral.sh/uv/install.sh | sh
%environment
    export PYTHONPATH=/cwc PYTHONDONTWRITEBYTECODE=1
    export PATH="/root/.local/bin:$PATH"
%runscript
    cd /cwc && make -f Makefile.cwc reproduce-primary
