python3 -B -c "import unittest; suite=unittest.defaultTestLoader.discover('tests', pattern='test_cneh_history_guard.py'); result=unittest.TextTestRunner(verbosity=2).run(suite); raise SystemExit(0 if result.wasSuccessful() and result.testsRun>=16 and not result.skipped and not result.expectedFailures and not result.unexpectedSuccesses else 1)"
python3 -B scripts/cneh_history_guard.py
find artifacts -name SHA256SUMS -not -path '*/.git/*' -printf '%h\n' | sort | while IFS= read -r d; do \
	echo "checking $d"; \
	if grep -Eq '^[[:xdigit:]]{64} [ *]artifacts/' "$d/SHA256SUMS"; then \
		sha256sum -c "$d/SHA256SUMS" >/dev/null && echo "  OK" || exit 1; \
	else \
		(cd "$d" && sha256sum -c SHA256SUMS >/dev/null && echo "  OK") || exit 1; \
	fi; \
done
