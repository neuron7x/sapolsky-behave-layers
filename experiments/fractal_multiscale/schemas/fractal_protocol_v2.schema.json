{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwc-fractal.local/schemas/fractal_protocol_v2.schema.json",
  "title": "CWC Robust Multiscale Protocol v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id", "status", "hypothesis", "scales", "minimum_series_length",
    "feature_mappings", "confounder_strata", "null_models", "null_iterations",
    "acceptance_gates", "claim_boundary"
  ],
  "properties": {
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "status": {"const": "frozen"},
    "hypothesis": {"type": "string", "minLength": 80},
    "scales": {
      "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
      "items": {"enum": ["micro", "meso", "macro"]}
    },
    "minimum_series_length": {"type": "integer", "minimum": 32},
    "feature_mappings": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_scale", "target_scale", "pairs"],
        "properties": {
          "source_scale": {"enum": ["micro", "meso", "macro"]},
          "target_scale": {"enum": ["micro", "meso", "macro"]},
          "pairs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "confounder_strata": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["batch_size", "sequence_length"]}
    },
    "null_models": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"enum": [
        "within_stratum_shuffle_target", "circular_shift_target", "block_permutation_target"
      ]}
    },
    "null_iterations": {"type": "integer", "minimum": 200},
    "acceptance_gates": {
      "type": "object", "additionalProperties": false,
      "required": [
        "require_all_scales", "require_all_edges", "min_valid_pair_fraction",
        "min_residual_delta_vs_max_null", "max_familywise_p_value",
        "require_synthetic_control_calibration"
      ],
      "properties": {
        "require_all_scales": {"const": true},
        "require_all_edges": {"const": true},
        "min_valid_pair_fraction": {"type": "number", "minimum": 0.5, "maximum": 1.0},
        "min_residual_delta_vs_max_null": {"type": "number", "minimum": 0.0},
        "max_familywise_p_value": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 0.1},
        "require_synthetic_control_calibration": {"const": true}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 80}
  }
}
