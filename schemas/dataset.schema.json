{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWC synthetic generator dataset register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasets"
  ],
  "properties": {
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "version",
          "generator",
          "kind",
          "construct",
          "license",
          "associated_experiments"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "generator": {
            "type": "string",
            "pattern": "^experiments/"
          },
          "kind": {
            "const": "synthetic-generator"
          },
          "construct": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "known_limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "associated_experiments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
