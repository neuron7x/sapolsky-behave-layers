{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cwc/claim.schema.json",
  "title": "CWC Claim",
  "type": "object",
  "required": ["claim_id", "statement", "status"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CWC-"},
    "hypothesis_id": {"type": "string"},
    "statement": {"type": "string", "minLength": 10},
    "level": {"type": "string"},
    "status": {"enum": ["SUPPORTED", "SUPPORTED_NARROWED", "NOT_SUPPORTED", "NOT_TESTED", "INSTRUMENT_INVALID", "NOT_IDENTIFIABLE"]},
    "scope": {"type": "object"},
    "commit": {"type": "string"},
    "protocol_id": {"type": "string"},
    "required_artifacts": {"type": "array", "items": {"type": "string"}},
    "supporting_metrics": {"type": "array", "items": {"type": "string"}},
    "failed_controls": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "prohibited_extrapolations": {"type": "array", "items": {"type": "string"}},
    "note": {"type": "string"},
    "independent_replication": {"type": "boolean"},
    "verdict_binding": {
      "type": ["object", "null"],
      "required": ["file", "pointer", "expected"],
      "properties": {
        "file": {"type": "string"},
        "pointer": {"type": ["string", "null"]},
        "expected": {"type": ["string", "boolean"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
