# CWC WP-1 verification closure. Namespaced Makefile.cwc so it never shadows
# any Makefile nanochat itself might add. Invoke: `make -f Makefile.cwc verify`.
#
# PY defaults to the exact-pinned venv resolved from nanochat's uv.lock; override
# with `make -f Makefile.cwc PY=python verify` on a fresh checkout.
PY ?= .venv/bin/python
COVERAGE_FAIL_UNDER ?= 95

.PHONY: dual-sided-verifier-gate
# Additive admission: preserves all existing scientific/release gates. Reject-all,
# accept-all, contradiction promotion and verifier crashes must be killed first.
verify pr-fast: dual-sided-verifier-gate

dual-sided-verifier-gate:
	$(PY) -m ruff check cwc/governance/verifier_qualification.py cwc/governance/planner_admission.py scripts/dual_sided_verifier_gate.py tests/test_dual_sided_verifier.py
	$(PY) -m mypy --config-file mypy.ini --follow-imports=silent cwc/governance/verifier_qualification.py cwc/governance/planner_admission.py scripts/dual_sided_verifier_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/test_dual_sided_verifier.py tests/test_proof_carrying_planner.py --cov=cwc.governance.verifier_qualification --cov=cwc.governance.planner_admission --cov-branch --cov-report=term-missing --cov-fail-under=100
	PYTHONPATH=. $(PY) scripts/dual_sided_verifier_gate.py --output-dir assurance-build/dual-sided-verifier

.PHONY: verify lint typecheck test inference-integrity data-intake-test readiness-test technical-quality-gate coverage properties mutation determinism clean-pyc install-dev experiment-tests reproduce-mechanism verify-evidence validate-evidence reproduce-primary make-release doc-gate bib-gate docs-regen pr-fast pr-security pr-full truth-gate workflow-lint secret-scan dependency-audit dependency-integrity-gate architecture-gate hermeticity-gate complexity-gate sbom-gate inference-integrity-gate assurance-attack assurance-report engineering-assurance verdict-binding formal-identifiability-gate causal-debt-gate research-ingestion-gate research-execution-gate research-ops-gate rd03-gate csca03r-gate csca04-gate csca05-gate csca06a-gate csca06a-r1-gate csca06-info-gate csca06b-gate csca06c-gate csca07-gate csca08-gate cog-countermodel01-gate cog-epistemic01r-gate cog-memory01-gate cog-plan01-gate cab01-q1-gate cab01-q1-r1-gate cog-self01-gate current-prereg-gate dgc-gate dgc-financial-gate formal-identifiability-gate

# The full gate, ordered cheapest-first so a fast failure surfaces first.
verify: lint typecheck test inference-integrity data-intake-test readiness-test technical-quality-gate coverage mutation experiment-tests validate-evidence verdict-binding formal-identifiability-gate causal-debt-gate research-ingestion-gate research-execution-gate research-ops-gate rd03-gate csca03r-gate csca04-gate csca05-gate csca06a-gate csca06a-r1-gate csca06-info-gate csca06b-gate csca06c-gate csca07-gate csca08-gate cog-countermodel01-gate cog-epistemic01r-gate cog-memory01-gate cog-plan01-gate cab01-q1-gate cab01-q1-r1-gate doc-gate cog-self01-gate dgc-gate dgc-financial-gate
	@echo "CWC-VERIFY: ALL GATES PASSED"

# WP16 (Act CWC-ASCEND-2026-01, G0/G1): the SINGLE canonical reproduction command --
# the full gate PLUS evidence-checksum verification and from-scratch primary reproduction.
# This is the one command a clean-room operator runs. Use PY=<fresh-venv> on a clean checkout.
verify-full: verify verify-evidence reproduce-primary
	@echo "CWC-VERIFY-FULL: reproduction spine complete (gates + checksums + primary reproduced)"

# PR admission commands. The same targets are used locally and by GitHub Actions.
# pr-fast is the feedback loop; pr-security is the public-repository safety gate;
# pr-full is the merge-grade scientific verification and falsification cycle.
pr-fast: truth-gate lint typecheck test inference-integrity data-intake-test readiness-test technical-quality-gate validate-evidence verdict-binding formal-identifiability-gate causal-debt-gate research-ingestion-gate research-execution-gate research-ops-gate rd03-gate csca03r-gate csca04-gate csca05-gate csca06a-gate csca06a-r1-gate csca06-info-gate csca06b-gate csca06c-gate csca07-gate csca08-gate cog-countermodel01-gate cog-epistemic01r-gate cog-memory01-gate cog-plan01-gate cab01-q1-gate cab01-q1-r1-gate doc-gate cog-self01-gate dgc-gate dgc-financial-gate
	@echo "CWC-PR-FAST: ALL GATES PASSED"

pr-security: truth-gate workflow-lint secret-scan dependency-integrity-gate dependency-audit engineering-assurance
	@echo "CWC-PR-SECURITY: ALL GATES PASSED"

pr-full: verify-full pr-security
	@echo "CWC-PR-FULL: ALL GATES PASSED"

truth-gate:
	PYTHONPATH=. $(PY) scripts/truth_gate.py

workflow-lint:
	docker run --rm --user "$$(id -u):$$(id -g)" \
		-v "$$(pwd):/repo" -w /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 \
		-color .github/workflows/*.yml

secret-scan:
	docker run --rm --user "$$(id -u):$$(id -g)" \
		-v "$$(pwd):/repo" -w /repo zricethezav/gitleaks:v8.28.0@sha256:cdbb7c955abce02001a9f6c9f602fb195b7fadc1e812065883f695d1eeaba854 \
		git --redact --no-banner --exit-code 1 --log-opts=--all

dependency-audit:
	uv export --quiet --frozen --extra cpu --no-dev --no-emit-project --output-file /tmp/cwc-runtime-requirements.txt
	sed -E 's/(torch==[0-9.]+)\+cpu/\1/' /tmp/cwc-runtime-requirements.txt > /tmp/cwc-auditable-requirements.txt
	uvx --from pip-audit==2.10.1 pip-audit --disable-pip -r /tmp/cwc-auditable-requirements.txt --progress-spinner=off
	uv export --quiet --frozen --extra cpu --only-dev --no-emit-project --output-file /tmp/cwc-dev-group-requirements.txt
	uvx --from pip-audit==2.10.1 pip-audit --disable-pip -r /tmp/cwc-dev-group-requirements.txt --progress-spinner=off
	uvx --from pip-audit==2.10.1 pip-audit -r cwc-requirements-dev.txt --progress-spinner=off

dependency-integrity-gate:
	PYTHONPATH=. $(PY) scripts/dependency_integrity_gate.py --self-test
	PYTHONPATH=. $(PY) scripts/dependency_integrity_gate.py

# Eight project-level engineering capabilities: explicit architecture, hermetic
# reproduction, algorithmic budgets, offline dependency integrity, deterministic SBOM,
# adversarial gate attacks, machine-readable assurance evidence, and mandatory CI admission.
architecture-gate:
	PYTHONPATH=. $(PY) scripts/architecture_gate.py

hermeticity-gate:
	PYTHONPATH=. $(PY) scripts/hermeticity_gate.py

complexity-gate:
	PYTHONPATH=. $(PY) scripts/complexity_gate.py

sbom-gate:
	PYTHONPATH=. $(PY) scripts/build_sbom.py --check

assurance-attack:
	PYTHONPATH=. $(PY) scripts/assurance_attack.py

inference-integrity-gate:
	PYTHONPATH=. $(PY) scripts/inference_integrity_gate.py

assurance-report:
	PYTHONPATH=. $(PY) scripts/assurance_report.py

engineering-assurance: architecture-gate hermeticity-gate complexity-gate dependency-integrity-gate sbom-gate inference-integrity-gate assurance-attack assurance-report
	@echo "CWC-ENGINEERING-ASSURANCE: ALL GATES PASSED"

# DGC P0 governance gate: executable invariants, oracle semantics, injected faults,
# and non-promoting development evidence integrity.
dgc-gate:
	PYTHONPATH=. $(PY) -m pytest -q tests/test_dgc_core.py tests/test_dgc_governance_v2.py tests/test_dgc_oracle_experiment.py
	PYTHONPATH=. $(PY) scripts/dgc_verification_gate.py

# Financial DGC gate: validates both non-promoting development evidence and the
# prospectively preregistered synthetic confirmation while explicitly forbidding
# client/commercial promotion from synthetic results.
dgc-financial-gate:
	PYTHONPATH=. $(PY) -m pytest -q tests/test_dgc_financial_verification.py
	PYTHONPATH=. $(PY) scripts/dgc_financial_gate.py

# Current-tree temporal preregistration integrity. Unlike the sealed historical WP12
# audit, this follows the live hypothesis registry including research/preregistration/.
current-prereg-gate:
	PYTHONPATH=. $(PY) scripts/current_prereg_integrity_gate.py --self-test
	PYTHONPATH=. $(PY) scripts/current_prereg_integrity_gate.py

# Documentation-methodology spine (Act CWC-LAB-DOC-2026-01): registry schema-valid,
# commit current, 0 claim/hypothesis orphans, required artifacts exist, P0 docs present.
# bib-gate is part of it: a bibliography is the one artefact a reader cannot check by
# running the code, so it is checked here instead (offline, deterministic).
doc-gate: bib-gate current-prereg-gate
	PYTHONPATH=. $(PY) scripts/doc_status_gate.py

# Every registered status must equal the polarity of the CHECKSUMMED verdict it rests on,
# and every coherence-ladder row must resolve to a real claim id. Runs its own falsifier
# first: four injected defects must be detected before the real audit is trusted.
verdict-binding:
	PYTHONPATH=. $(PY) scripts/verdict_binding_gate.py cwc/causal/observability.py scripts/formal_identifiability_gate.py --self-test
	PYTHONPATH=. $(PY) scripts/verdict_binding_gate.py cwc/causal/observability.py scripts/formal_identifiability_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/test_verdict_binding_gate.py


formal-identifiability-gate:
	PYTHONPATH=. $(PY) scripts/formal_identifiability_gate.py --self-test
	PYTHONPATH=. $(PY) scripts/formal_identifiability_gate.py
	PYTHONPATH=. $(PY) scripts/counterfactual_basis_identifiability_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/test_formal_identifiability.py tests/test_counterfactual_basis_identifiability.py

causal-debt-gate:
	PYTHONPATH=. $(PY) scripts/causal_debt_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/causal_debt

research-ingestion-gate:
	PYTHONPATH=. $(PY) scripts/research_ingestion_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/test_research_ingestion_gate.py

research-execution-gate:
	PYTHONPATH=. $(PY) scripts/research_execution_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/test_research_execution_gate.py

research-ops-gate:
	PYTHONPATH=. $(PY) scripts/research_ops_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/research_ops tests/test_research_ops_gate.py

# Offline bibliography gate: every citation machine-resolved, titles unaltered, every
# reference attached to a real claim and argued in the related-work review.
bib-gate:
	PYTHONPATH=. $(PY) scripts/verify_bibliography.py

# Regenerate the machine-derived docs from real state (experiment ledger + the document
# register, which is curated-governance entries UNION a glob over docs/ so no document can
# be silently untracked).
docs-regen:
	PYTHONPATH=. $(PY) scripts/build_experiment_ledger.py
	PYTHONPATH=. $(PY) scripts/build_document_register.py

lint:
	$(PY) -m ruff check .

typecheck:
	$(PY) -m mypy --config-file mypy.ini cwc/instrumentation/ nanochat/inference_contracts.py nanochat/model_integrity.py experiments/common/value_information.py experiments/common/adaptive_value_theory.py experiments/common/neuron_information_budget.py experiments/common/coherence_audit.py experiments/common/value_of_information_rate.py experiments/common/identifiability_inference.py scripts/instrumentation_smoke.py scripts/instrumentation_audit.py scripts/export_cwc_instrumentation_bundle.py scripts/mutation_probe.py scripts/verify_bibliography.py scripts/build_bibliography.py scripts/build_document_register.py scripts/data_asset_audit.py scripts/readiness_oracle.py scripts/technical_quality_gate.py scripts/architecture_gate.py scripts/hermeticity_gate.py scripts/complexity_gate.py scripts/inference_integrity_gate.py scripts/assurance_attack.py scripts/assurance_report.py scripts/verdict_binding_gate.py

# Fast behavioral suite (excludes CUDA-hardware and the minutes-long mutation gate).
test:
	$(PY) -m pytest -q -m "not slow and not mutation" \
		tests/test_instrumentation_*.py tests/test_evidence_validation.py

inference-integrity:
	PYTHONPATH=. $(PY) -m pytest -q tests/test_inference_integrity.py tests/test_engine.py

data-intake-test:
	PYTHONPATH=. $(PY) -m pytest -q tests/test_data_asset_audit.py

readiness-test:
	PYTHONPATH=. $(PY) -m pytest -q tests/test_readiness_oracle.py

technical-quality-gate:
	PYTHONPATH=. $(PY) scripts/technical_quality_gate.py
	PYTHONPATH=. $(PY) -m pytest -q tests/test_technical_quality_gate.py

# Coverage gate. The canonical GPU-capable floor remains 95%. A hermetic CPU
# runner may explicitly set 91 because CUDA/NVML-only branches are unreachable;
# its observed baseline is 91.04%, leaving essentially no regression margin.
# The measured subject is the packages these suites own; the rest of cwc/ (governance,
# replay, research_ops, ...) is gated by its own suites and must not dilute this ratio.
COVERAGE_SUBJECT = --cov=cwc/instrumentation --cov=cwc/plasticity --cov=cwc/evidence --cov=cwc/assurance
coverage:
	$(PY) -m pytest -q -m "not slow and not mutation" \
		tests/test_instrumentation_*.py tests/test_data_asset_audit.py tests/test_readiness_oracle.py \
		experiments/wp3_plasticity_v1/tests/ \
		$(COVERAGE_SUBJECT) --cov-branch --cov-report=term-missing --cov-fail-under=$(COVERAGE_FAIL_UNDER)

properties:
	$(PY) -m pytest -q tests/test_instrumentation_properties.py

determinism:
	$(PY) -m pytest -q tests/test_instrumentation_determinism.py

# Mutation gate: asserts 100% kill rate over the curated mathematical-core mutants.
mutation:
	$(PY) scripts/mutation_probe.py

# Act v2.0 A0 — experiment reproduction + evidence verification
# GLOB, not a hard-coded list: every experiments/*/tests dir is auto-included so a new
# experiment can never be silently omitted (fractal_multiscale excluded: needs py3.11+jsonschema).
experiment-tests:
	PYTHONPATH=. $(PY) -m pytest -q $$(find experiments -path '*/tests' -type d -not -path '*fractal_multiscale*' -not -path '*__pycache__*' | sort)

reproduce-mechanism:
	PYTHONPATH=. $(PY) experiments/wp2_mechanism_v2/src/runner_mech.py --seeds 0 1 2 3 4 5 6 7 --out artifacts/wp2-mechanism-v2/raw_runs
	PYTHONPATH=. $(PY) experiments/wp2_mechanism_v2/src/analyze_mech.py

# GLOB, not a hard-coded list: every bundle carrying a SHA256SUMS is checked, so an evidence
# bundle can never be silently left unverified (this closed the wp4-end-to-end-v4 omission).
verify-evidence:
	@find artifacts -name SHA256SUMS -not -path '*/.git/*' -printf '%h\n' | sort | while IFS= read -r d; do \
		echo "checking $$d"; \
		if grep -Eq '^[[:xdigit:]]{64} [ *]artifacts/' "$$d/SHA256SUMS"; then \
			sha256sum -c "$$d/SHA256SUMS" >/dev/null && echo "  OK" || exit 1; \
		else \
			(cd "$$d" && sha256sum -c SHA256SUMS >/dev/null && echo "  OK") || exit 1; \
		fi; \
	done

validate-evidence:
	PYTHONPATH=. $(PY) scripts/validate_evidence.py

reproduce-primary:
	PYTHONPATH=. $(PY) scripts/reproduce_primary.py

make-release:
	PYTHONPATH=. $(PY) scripts/make_release.py --out release-build

clean-pyc:
	find . -path ./.git -prune -o -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
	find . -name "*.pyc" -not -path "./.git/*" -delete 2>/dev/null || true

install-dev:
	VIRTUAL_ENV=.venv uv pip install -r cwc-requirements-dev.txt

rd03-gate:
	$(PY) scripts/rd03_gate.py --self-test
	$(PY) scripts/rd03_gate.py


