# CWC WP-1 verification closure. Namespaced Makefile.cwc so it never shadows
# any Makefile nanochat itself might add. Invoke: `make -f Makefile.cwc verify`.
#
# PY defaults to the exact-pinned venv resolved from nanochat's uv.lock; override
# with `make -f Makefile.cwc PY=python verify` on a fresh checkout.
PY ?= .venv/bin/python

.PHONY: verify lint typecheck test coverage properties mutation determinism clean-pyc install-dev experiment-tests reproduce-mechanism verify-evidence validate-evidence reproduce-primary make-release doc-gate bib-gate docs-regen

# The full gate, ordered cheapest-first so a fast failure surfaces first.
verify: lint typecheck test coverage mutation experiment-tests validate-evidence doc-gate
	@echo "CWC-VERIFY: ALL GATES PASSED"

# WP16 (Act CWC-ASCEND-2026-01, G0/G1): the SINGLE canonical reproduction command --
# the full gate PLUS evidence-checksum verification and from-scratch primary reproduction.
# This is the one command a clean-room operator runs. Use PY=<fresh-venv> on a clean checkout.
verify-full: verify verify-evidence reproduce-primary
	@echo "CWC-VERIFY-FULL: reproduction spine complete (gates + checksums + primary reproduced)"

# Documentation-methodology spine (Act CWC-LAB-DOC-2026-01): registry schema-valid,
# commit current, 0 claim/hypothesis orphans, required artifacts exist, P0 docs present.
# bib-gate is part of it: a bibliography is the one artefact a reader cannot check by
# running the code, so it is checked here instead (offline, deterministic).
doc-gate: bib-gate
	PYTHONPATH=. $(PY) scripts/doc_status_gate.py

# Offline bibliography gate: every citation machine-resolved, titles unaltered, every
# reference attached to a real claim and argued in the related-work review.
bib-gate:
	PYTHONPATH=. $(PY) scripts/verify_bibliography.py

# Regenerate the machine-derived docs from real state (experiment ledger + the document
# register, which is curated-governance entries UNION a glob over docs/ so no document can
# be silently untracked).
docs-regen:
	PYTHONPATH=. $(PY) scripts/build_experiment_ledger.py
	PYTHONPATH=. $(PY) scripts/build_document_register.py

lint:
	$(PY) -m ruff check .

typecheck:
	$(PY) -m mypy --config-file mypy.ini cwc/ experiments/common/value_information.py experiments/common/adaptive_value_theory.py experiments/common/neuron_information_budget.py experiments/common/coherence_audit.py experiments/common/value_of_information_rate.py experiments/common/identifiability_inference.py scripts/instrumentation_smoke.py scripts/instrumentation_audit.py scripts/export_cwc_instrumentation_bundle.py scripts/mutation_probe.py scripts/verify_bibliography.py scripts/build_bibliography.py scripts/build_document_register.py

# Fast behavioral suite (excludes CUDA-hardware and the minutes-long mutation gate).
test:
	$(PY) -m pytest -q -m "not slow and not mutation" \
		tests/test_instrumentation_*.py tests/test_evidence_validation.py

# Coverage gate. Floor 95% tolerates a CPU-only runner (where @cuda tests skip,
# ~97%); on a CUDA host this reports ~99%.
coverage:
	$(PY) -m pytest -q -m "not slow and not mutation" \
		tests/test_instrumentation_*.py experiments/wp3_plasticity_v1/tests/ \
		--cov=cwc --cov-branch --cov-report=term-missing --cov-fail-under=95

properties:
	$(PY) -m pytest -q tests/test_instrumentation_properties.py

determinism:
	$(PY) -m pytest -q tests/test_instrumentation_determinism.py

# Mutation gate: asserts 100% kill rate over the curated mathematical-core mutants.
mutation:
	$(PY) scripts/mutation_probe.py

# Act v2.0 A0 — experiment reproduction + evidence verification
# GLOB, not a hard-coded list: every experiments/*/tests dir is auto-included so a new
# experiment can never be silently omitted (fractal_multiscale excluded: needs py3.11+jsonschema).
experiment-tests:
	PYTHONPATH=. $(PY) -m pytest -q $$(find experiments -path '*/tests' -type d -not -path '*fractal_multiscale*' -not -path '*__pycache__*' | sort)

reproduce-mechanism:
	PYTHONPATH=. $(PY) experiments/wp2_mechanism_v2/src/runner_mech.py --seeds 0 1 2 3 4 5 6 7 --out artifacts/wp2-mechanism-v2/raw_runs
	PYTHONPATH=. $(PY) experiments/wp2_mechanism_v2/src/analyze_mech.py

# GLOB, not a hard-coded list: every bundle carrying a SHA256SUMS is checked, so an evidence
# bundle can never be silently left unverified (this closed the wp4-end-to-end-v4 omission).
verify-evidence:
	@find artifacts -name SHA256SUMS -not -path '*/.git/*' -printf '%h\n' | sort | while read d; do \
		echo "checking $$d"; (cd $$d && sha256sum -c SHA256SUMS >/dev/null && echo "  OK") || exit 1; done

validate-evidence:
	PYTHONPATH=. $(PY) scripts/validate_evidence.py

reproduce-primary:
	PYTHONPATH=. $(PY) scripts/reproduce_primary.py

make-release:
	PYTHONPATH=. $(PY) scripts/make_release.py --out release-build

clean-pyc:
	find . -path ./.git -prune -o -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
	find . -name "*.pyc" -not -path "./.git/*" -delete 2>/dev/null || true

install-dev:
	VIRTUAL_ENV=.venv uv pip install -r cwc-requirements-dev.txt
