	$(PY) scripts/cog_countermodel01_gate.py


cog-epistemic01r-gate:
	$(PY) scripts/cog_epistemic01r_gate.py --self-test
	$(PY) scripts/cog_epistemic01r_gate.py


cog-memory01-gate:
	$(PY) scripts/cog_memory01_gate.py --self-test
	$(PY) scripts/cog_memory01_gate.py


